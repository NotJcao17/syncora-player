<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 o mas: portada grande a la izquierda; titulo, artista y controles a
     la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncora_np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/syncora_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/syncora_np_cover"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/syncora_widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/syncora_np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/syncora_widget_idle_title"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/syncora_np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/syncora_widget_idle_subtitle"
            android:textColor="#FFA0A0A0"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/syncora_np_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Anterior"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/syncora_widget_prev" />

            <ImageButton
                android:id="@+id/syncora_np_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/syncora_widget_play_bg"
                android:contentDescription="Reproducir"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/syncora_widget_play" />

            <ImageButton
                android:id="@+id/syncora_np_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Siguiente"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/syncora_widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
