<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncora_col_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/syncora_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/syncora_col_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/syncora_widget_cover_placeholder" />

    <TextView
        android:id="@+id/syncora_col_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/syncora_widget_pick"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/syncora_col_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="#FFA0A0A0"
        android:textSize="11sp" />
</LinearLayout>
